# Copy to .env and fill in real values — see README.md for what each does.
# `make dev` passes this straight to `docker run --env-file`.

JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=
JIRA_JQL=project = XXX AND statusCategory != Done ORDER BY priority DESC

BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=target-repo
BITBUCKET_TOKEN=

MINION_COMMAND=["docker","run","--rm","-i","-e","BITBUCKET_WORKSPACE","-e","BITBUCKET_REPO_SLUG","-e","BITBUCKET_TOKEN","minion:latest"]

# Optional — defaults shown (see src/foreman/config.mts)
# FOREMAN_DB_PATH=./foreman.db
# MINION_TIMEOUT_MS=600000
# FOREMAN_POLL_INTERVAL_MS=60000
# FOREMAN_API_PORT=3000
# FOREMAN_BUDGET=
# FOREMAN_QUEUE_TICKET=
