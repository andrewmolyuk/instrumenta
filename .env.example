# Copy to .env and fill in real values — see README.md for what each does.
# `make dev` passes this straight to `docker run --env-file`.

JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=
JIRA_JQL=project = XXX AND statusCategory != Done ORDER BY priority DESC

BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=target-repo
BITBUCKET_TOKEN=
# Minion-only, read directly (not via src/foreman/config.mts) — the branch a PR's
# opened against. Must match the target repo's actual default branch, or PR
# creation fails outright; Bitbucket doesn't infer it. Defaults to "main" if unset.
# BITBUCKET_BASE_BRANCH=main

# Minion-only — comma-separated Bitbucket account UUIDs (not display names or
# usernames; Bitbucket's PR API only accepts UUIDs) added as reviewers on every
# PR Minion opens. Find a UUID via that person's PR/commit participation in the
# target repo (Bitbucket doesn't expose a name-search endpoint on most tokens).
# Optional — no reviewers are added if unset.
# BITBUCKET_PR_REVIEWERS={uuid-one},{uuid-two}

# Minion-only — the git identity commits land under in the target repo. Defaults
# to "instrumenta-minion" / "minion@instrumenta.invalid" if unset.
# MINION_GIT_AUTHOR_NAME=Instrumenta
# MINION_GIT_AUTHOR_EMAIL=instrumenta@your-org.example

# Minion-only — the model and reasoning effort Claude Code runs with inside Minion
# (`--model` / `--effort`). Defaults to Opus 5's 1M-context variant at `high` effort;
# pinned in code rather than left to the CLI's defaults so cost per attempt doesn't
# move on its own. To override, uncomment and add `-e MINION_CLAUDE_MODEL -e
# MINION_CLAUDE_EFFORT` to MINION_COMMAND below — otherwise they never reach the
# container. Effort levels: low, medium, high, xhigh, max.
# MINION_CLAUDE_MODEL=claude-opus-5[1m]
# MINION_CLAUDE_EFFORT=high

# Claude Code auth inside Minion's sandbox — see README.md
# Generate with `claude setup-token` (requires a Pro/Max/Team/Enterprise subscription).
CLAUDE_CODE_OAUTH_TOKEN=

# Bare git mirror shared across Minions (ADR-013): turns a 5-7 minute clone of
# the target repo into seconds. Unset it to clone directly every time.
MINION_GIT_CACHE=/cache

MINION_COMMAND=["docker","run","--rm","-i","-v","instrumenta-minion-git-cache:/cache","-e","MINION_GIT_CACHE","-e","BITBUCKET_WORKSPACE","-e","BITBUCKET_REPO_SLUG","-e","BITBUCKET_TOKEN","-e","BITBUCKET_BASE_BRANCH","-e","BITBUCKET_PR_REVIEWERS","-e","MINION_GIT_AUTHOR_NAME","-e","MINION_GIT_AUTHOR_EMAIL","-e","CLAUDE_CODE_OAUTH_TOKEN","-e","JIRA_BASE_URL","-e","JIRA_EMAIL","-e","JIRA_API_TOKEN","minion:latest"]

# Optional — defaults shown (see src/foreman/config.mts)
# FOREMAN_DB_PATH=./foreman.db
# MINION_TIMEOUT_MS=600000
# FOREMAN_POLL_INTERVAL_MS=60000
# FOREMAN_API_PORT=3000
# FOREMAN_BUDGET=
# FOREMAN_QUEUE_TICKET=
